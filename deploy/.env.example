# Прод-конфигурация сервера MasterSetting.
# Скопируйте в deploy/.env и заполните. НЕ коммитьте .env в git.

# --- База данных (контейнер db) ---
POSTGRES_DB=mastersetting
POSTGRES_USER=mastersetting
POSTGRES_PASSWORD=change_me_strong_db_password

# --- JWT ---
# Сгенерировать: openssl rand -hex 32
MS_JWT_SECRET=change_me_64_hex_chars

# --- Первый администратор (создаётся при первом старте) ---
MS_ADMIN_LOGIN=admin
MS_ADMIN_PASSWORD=change_me_strong_admin_password
