# Сборочный образ для портативной Windows-сборки MasterSetting.
# Собирает MasterSetting.exe под Wine на Linux — без Windows-машины и без GitHub.
#
# Сборка образа:
#   docker build -t ms-build -f deploy/Dockerfile.wine-build .
# Запуск:
#   docker run --rm -v "$PWD":/src ms-build
# Результат: dist/MasterSetting/MasterSetting.exe (+ zip в deploy/build_in_wine.sh)
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    WINEDEBUG=-all \
    WINEPREFIX=/root/.wine \
    WINEARCH=win64

# --- Wine + утилиты (полная сборка Python с tkinter не требует wine32) ---
RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        wine64 wine32:i386 winbind cabextract xvfb wget unzip python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY deploy/build_in_wine.sh /usr/local/bin/build_in_wine.sh
RUN chmod +x /usr/local/bin/build_in_wine.sh

ENTRYPOINT ["/usr/local/bin/build_in_wine.sh"]
